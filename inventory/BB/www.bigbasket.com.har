: \"Subscription successful!\",\n        \"iconUrl\" : \"https://www.bbassets.com/media/uploads/2026/4/8/Subscribed.png\",\n        \"description_low\" : \"Deliveries require sufficient bbWallet balance\",\n        \"iconUrlLowBalance\" : \"https://www.bbassets.com/media/uploads/2026/4/8/Paused.png\",\n        \"description_not_low\" : \"We’ll deliver it as per your schedule by 7 AM\",\n        \"heading_low_balance\" : \"Your subscription is saved\"\n      },\n      \"landingPageHeaderCoachmark\" : {\n        \"text\" : \"Easily manage subscriptions and bbWallet from here\",\n        \"global\" : 0,\n        \"enabled\" : true,\n        \"dayLevel\" : 0,\n        \"lottieURL\" : \"https://bigbasket.com/media/uploads/2026/1/12/wallet.png\",\n        \"cooldownDays\" : 2\n      },\n      \"subscription_available_tag\" : {\n        \"display_text\" : \"Available for subscription\"\n      },\n      \"subscription_sticky_widget\" : {\n        \"enabled_llc_slugs\" : [ \"fresh-milk\", \"curd\", \"cut-fruit-tender-coconut\", \"buttermilk-lassi\", \"milk\" ]\n      },\n      \"topUpCoachmarkMigratedUser\" : {\n        \"CTA\" : \"Try 7 AM delivery\",\n        \"global\" : 5,\n        \"content\" : [ \"Order by 12 AM & get by 7 AM next day\", \"Get your order along with subscribed products\" ],\n        \"enabled\" : true,\n        \"dayLevel\" : 1,\n        \"imageUrl\" : \"https://bigbasket.com/media/uploads/2026/1/9/bbd-topup-bs-basket.png\",\n        \"cooldownDays\" : 5\n      },\n      \"landingPageCoachmarkJourney\" : {\n        \"global\" : 1,\n        \"enabled\" : false,\n        \"dayLevel\" : 1,\n        \"cooldownDays\" : 2,\n        \"addCTACoachmarkText\" : \"Add here to get FREE & silent 7 AM delivery\",\n        \"addCTACoachmarkImageUrl\" : \"https://www.bbassets.com/media/uploads/coachmarks/subscribe_atb.png\",\n        \"subscribeCTACoachmarkText\" : \"Click here to Subscribe\",\n        \"addCTACoachmarkBGLottieURL\" : \"https://bigbasket.com/media/uploads/2026/1/12/Top-up.png\",\n        \"subscribeCTACoachmarkImageUrl\" : \"https://www.bbassets.com/media/uploads/coachmarks/subscribe.png\",\n        \"landingPageHeaderCoachmarkText\" : \"Easily manage subscriptions and bbWallet from here\",\n        \"subscribeCTACoachmarkBGLottieURL\" : \"https://bigbasket.com/media/uploads /2026/1/12/Subscribe.png\",\n        \"landingPageHeaderCoachmarkBGLottieURL\" : \"https://www.bbassets.com/media/uploads/2026/3/20/coachmark-bbwallet-subscription.png\"\n      },\n      \"listingPageCoachmarkJourney\" : {\n        \"global\" : 1,\n        \"enabled\" : true,\n        \"dayLevel\" : 1,\n        \"cooldownDays\" : 10,\n        \"addCTACoachmarkText\" : \"Add to get FREE & silent delivery by 7 AM\",\n        \"addCTACoachmarkImageUrl\" : \"https://www.bbassets.com/media/uploads/coachmarks/subscribe_atb.png\",\n        \"subscribeCTACoachmarkText\" : \"Click here to Subscribe\",\n        \"addCTACoachmarkBGLottieURL\" : \"https://bigbasket.com/media/uploads/2026/1/12/Top-up.png\",\n        \"subscribeCTACoachmarkImageUrl\" : \"https://www.bbassets.com/media/uploads/coachmarks/subscribe.png\",\n        \"subscribeCTACoachmarkBGLottieURL\" : \"https://bigbasket.com/media/uploads /2026/1/12/Subscribe.png\"\n      },\n      \"subscribe_nudge_limit_config\" : {\n        \"day_all\" : 3,\n        \"day_llc\" : 2,\n        \"llc_level_global\" : 5,\n        \"global_lifetime_nudge_limit\" : 10\n      },\n      \"subscribe_nudge_popup_config\" : {\n        \"title\" : \"https://www.bbassets.com/media/uploads/2026/3/12/subscribe&get.png\",\n        \"heading\" : \"Buy this regularly?\",\n        \"benefits\" : [ \"Never worry about reordering\", \"Delivered by 7 AM\" ],\n        \"cta_text\" : \"Explore subscriptions\",\n        \"highlightText\" : \"https://www.bbassets.com/media/uploads/2026/3/12/freedelivery.png\"\n      },\n      \"subscribe_popup_limit_config\" : {\n        \"day_all\" : 2,\n        \"day_llc\" : 1,\n        \"llc_level_global\" : 2,\n        \"global_lifetime_nudge_limit\" : 5\n      },\n      \"subscription_cashback_config\" : {\n        \"tnc_link\" : \"https://www.bigbasket.com/fp/mobile/subscription_cashback_tnc/\",\n        \"bb_daily_empty_banner\" : \"https://www.bbassets.com/media/uploads/2026/4/9/bb_daily_empty_banner.png\",\n        \"subscription_lta_banner\" : \"https://www.bbassets.com/media/uploads/2026/4/10/total_cashback.png\",\n        \"cancel_subscription_text\" : \"You’re enjoying cashback benefits. Cancelling will stop future rewards.\",\n        \"subscribe_rain_tab_lottie\" : \"https://www.bbassets.com/media/uploads/2026/3/30/coin_rain.json\",\n        \"subscription_cashback_faq\" : [ {\n          \"faq_answer\" : \"An offer is automatically applied when you create a subscription for a product. If you’re eligible, you’ll see it on the product page.\",\n          \"faq_question\" : \"How does a cashback offer work?\"\n        }, {\n          \"faq_answer\" : \"Cashback is automatically credited to your bbWallet after each successful delivery, depending on the offers applied to your order.\",\n          \"faq_question\" : \"How & when will I receive cashback?\"\n        }, {\n          \"faq_answer\" : \"You can view all your cashback details in your bbWallet transactions by tapping on “View all cashback”.\",\n          \"faq_question\" : \"Where can I see my cashback history?\"\n        }, {\n          \"faq_answer\" : \"Yes. Cashback is calculated on the actual quantities delivered, based on the applicable limits of an offer. If you reduce the quantity, the cashback will reduce accordingly.\",\n          \"faq_question\" : \"Will my cashback change if I update the quantity?\"\n        }, {\n          \"faq_answer\" : \"You earn cashback only for successful deliveries. If your deliveries are skipped or paused, your cashback cycle simply pauses and resumes when deliveries start again.\",\n          \"faq_question\" : \"What happens if a delivery is skipped or paused?\"\n        }, {\n          \"faq_answer\" : \"If you return a product, the cashback earned for it will be deducted from your bbWallet. The rest of your cashback cycle will continue as is.\",\n          \"faq_question\" : \"What happens if I return a product after cashback is credited?\"\n        }, {\n          \"faq_answer\" : \"No. Cashback is non-transferable. It cannot be moved out of your bbWallet to any other account.\",\n          \"faq_question\" : \"Can I transfer cashback from my bbWallet to my source account?\"\n        }, {\n          \"faq_answer\" : \"Payment is automatically deducted from your bbWallet balance. Ensure you have sufficient balance for upcoming orders to continue your subscription.\",\n          \"faq_question\" : \"How do I pay for my bbDaily subscription orders?\"\n        }, {\n          \"faq_answer\" : \"No, there's no minimum order value. Subscribe to your daily needs as per your convenience.\",\n          \"faq_question\" : \"Is there a min. order value for bbDaily subscriptions?\"\n        }, {\n          \"faq_answer\" : \"No, bbDaily subscription orders have no delivery or handling charges.\",\n          \"faq_question\" : \"Are there any delivery or handling charges for bbDaily orders?\"\n        }, {\n          \"faq_answer\" : \"Go to Account > Subscription. Select the product and you'll find options to change quantity and frequency.\",\n          \"faq_question\" : \"How can I modify the delivery frequency or quantity?\"\n        }, {\n          \"faq_answer\" : \"If you receive damaged, wrong, or missing products, please contact our customer support for quick resolution.\",\n          \"faq_question\" : \"What if my order is damaged, wrong, or has missing products?\"\n        } ],\n        \"cashback_tag_animation_count\" : 2,\n        \"max_quantity_per_order_limit\" : 10,\n        \"subscription_updated_bs_coin\" : \"https://www.bbassets.com/media/uploads/2026/3/30/coins_icon_updated_bottom_sheet.png\",\n        \"subscription_success_cb_nudge\" : \"https://www.bbassets.com/media/uploads/2026/4/10/modify_subscription.png\",\n        \"subscription_slim_banner_lottie\" : \"https://www.bbassets.com/media/uploads/2026/3/30/coin_rotate.json\",\n        \"sub_cashback_updated_banner_rules\" : {\n          \"type\" : \"banner\",\n          \"frequency\" : 3\n        },\n        \"subscribe_success_confetti_lottie\" : \"https://www.bbassets.com/media/uploads/five_star_rating_confetti.json\",\n        \"subscription_header_banner_lottie\" : \"https://www.bbassets.com/media/uploads/2026/4/9/lifetime_cashback_lottie_banner.json\"\n      },\n      \"SubscriptionCashbackInfoConfig\" : {\n        \"primaryText\" : \"Subscribe & get\",\n        \"secondaryText\" : \" 5% cashback\"\n      },\n      \"lowWalletNudgeSubscriptionPage\" : {\n        \"iconUrl\" : \"https://bigbasket.com/media/uploads /2025/7/16/bbwallet_orange_image.png\",\n        \"description\" : \"Your subscription will get paused due to low wallet balance\",\n        \"primaryButtonText\" : \"Add money\"\n      },\n      \"subscription_offer_card_config\" : {\n        \"offer_ended\" : {\n          \"offer_tool_tip\" : \"Your cashback offer ended\"\n        },\n        \"offer_all_deliveries\" : {\n          \"offer_tool_tip\" : \"Cashback for all deliveries received.\"\n        },\n        \"offer_updated_finite\" : {\n          \"offer_tool_tip\" : \"Your cashback offer is updated\",\n          \"offer_display_title\" : \"Now you're getting %s on next %s deliveries\",\n          \"offer_display_subtitle\" : \"Valid on up to %s qty per order\"\n        },\n        \"offer_updated_infinite\" : {\n          \"offer_tool_tip\" : \"Your cashback offer is updated\",\n          \"offer_display_title\" : \"Now you're getting %s on each deliveries\",\n          \"offer_display_subtitle\" : \"Valid on up to %s qty per order\"\n        }\n      },\n      \"noOrdersForSubscriptionCustomer\" : {\n        \"title\" : \"No upco