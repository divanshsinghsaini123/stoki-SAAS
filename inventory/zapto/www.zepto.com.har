 condition\",\"title\":\"Phone condition\"},\"cancelExchangeModal\":{\"cancelExchangeText\":\"cancel exchange?\",\"cancelTitle\":\"No, Keep Exchange\",\"ctaTitle\":\"Yes, Cancel Exchange\",\"subTitle\":\"This action can't be undone.\",\"title\":\"Are you sure you want to\"},\"changeDeviceModal\":{\"cancelTitle\":\"No, Keep Exchange\",\"ctaTitle\":\"Yes, Update Device\",\"subTitle\":\"This action can't be undone.\",\"title\":\"This will remove current \\ninformation. Are you sure?\"},\"howitwork\":{\"image\":\"https://ik.imagekit.io/jupdt2k6txi/app/images/device_exchange_process.png\",\"steps\":[{\"description\":\"Receive a tentative price for your old device. Please note that this is an estimate only and Cashify will deem final value on doorstep evaluation\",\"title\":\"Get an Estimated Value\"},{\"description\":\"Pay the full amount for your new device through Zepto\",\"title\":\"Purchase Your New Device\"},{\"description\":\"Cashify will contact you via email, call, or WhatsApp to schedule the evaluation.\",\"title\":\"Post-Delivery Coordination\"},{\"description\":\"Ensure your old device has at least 50% battery and all personal data is backed up and erased before the inspection\",\"title\":\"Prepare for Evaluation\"},{\"description\":\" A Cashify representative will assess your device at your location and provide a final quote.\",\"title\":\"Doorstep Inspection\"},{\"description\":\"Upon agreement, Cashify will transfer the payment directly to your bank account.\",\"title\":\"Instant Transfer\"}],\"title\":\"How exchange works?\"},\"initiateProcess\":{\"ctaTitle\":\"Continue\",\"description\":\"Please provide your IMEI number to avail the exchange offer\",\"inputProps\":{\"placeholder\":\"IMEI Number\"},\"notes\":[\"Dial *#06# to find the IMEI number\",\"IMEI number should match against your device during pickup\"],\"notesHeading\":\"IMPORTANT NOTES\",\"title\":\"Enter IMEI Number\"},\"notServiceable\":{\"ctaTitle\":\"Continue Without Exchange\",\"subTitle\":\"