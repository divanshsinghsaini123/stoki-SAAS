s\":null, \"padding\":[0, 0, 0, 0]}}, \"widgetHeader\":{\"actionButton\":{\"positionMeta\":{}}, \"rightCta\":{\"actionId\":\"9a350f03-9959-44e3-a29f-3cd55e33c4c7\", \"actionType\":\"DEEPLINK_NAVIGATION\"}, \"viewMeta\":{\"background\":{}, \"infoTextProps\":{}, \"padding\":[0, 0, 0, 0], \"subtitleProps\":{}, \"titleProps\":{}}}, \"widgetId\":42836, \"widgetMeta\":{\"fontType\":null, \"footerInfo\":null, \"headerInfo\":null, \"minimumItemsRequired\":1, \"tagsScaleFactor\":null}, \"widgetName\":\"ALL_CAT_LIST_DESKTOP_1\", \"widgetType\":\"ALL_CATEGORIES_LIST_V1\"}, {\"action\":null, \"campaignName\":\"bachat\", \"data\":{\"endOfList\":true, \"items\":[{\"availableQuantity\":1, \"baseProductId\":\"4ad95205-6122-41b2-b5af-f18f187f924b\", \"bottomsheetType\":\"v1\", \"cached\":true, \"categoryId\":\"1a7e46a8-e627-450f-8960-490b550eeee6\", \"discountAmount\":3600, \"discountPercent\":13, \"discountedSellingPrice\":22400, \"id\":\"8f5eb151-9e1a-5f53-a171-299f6f539d9e\", \"isActive\":true, \"isCafe\":false, \"isPrimary\":true, \"isWishlistEnabled\":true, \"meta\":{\"tagsV2\":{\"P0\":{\"attachment\":{\"height\":36, \"id\":\"7f9897d0-a247-4079-af59-da82a6ae7592\", \"mediaType\":\"IMAGE\", \"name\":\"P0 - Discount.png\", \"path\":\"inventory/product/a61dd64f-be76-4ef6-8df8-802e086ecf56-P0_-_Discount.png\", \"width\":88}, \"id\":\"479ac2d1-b3e0-494c-bda4-300d124c4b88\", \"pdpAttachment\":{\"height\":36, \"id\":\"7f9897d0-a247-4079-af59-da82a6ae7592\", \"mediaType\":\"IMAGE\", \"name\":\"P0 - Discount.png\", \"path\":\"inventory/product/a61dd64f-be76-4ef6-8df8-802e086ecf56-P0_-_Discount.png\", \"width\":88}, \"position\":\"P0\", \"tagName\":\"Product Discount\", \"tagType\":\"DISCOUNT\"}}}, \"mrp\":26000, \"objectId\":\"8f5eb151-9e1a-5f53-a171-299f6f539d9e\", \"pricePerUom\":1120, \"pricingData\":{\"pricingEntityPrices\":[{\"discountedSellingPrice\":22400, \"pricingEntity\":\"SUPER_SAVER\"}]}, \"primaryCategoryName\":\"Cleaning Essentials\", \"primarySubcategoryId\":\"dfb37880-b40f-4783-9502-a56e12edbabc\", \"primarySubcategoryName\":\"Liquid Detergents & Additives\", \"product\":{\"brand\":\"Rin\", \"brandId\":\"cb69bece-e47d-44a4-a995-971ce8f9c13b\", \"countryOfOrigin\":\"India\", \"description\":[\"RIN LIQUIDS- Machine Specialist Rangea. A revolutionary liquid detergent, formulated to give CLEANING, BRIGHTNESS & FRAGRANCE. Rin Liquid gives Bright Like New clothes up to 100 washes in your Top Load Machine. Just add 1 cap of Rin Liquid for normal load of washing clothes. Add 1.5 caps of Rin Liquid to a heavy load of clothes to your Top Load washing machine to get the ultimate clean, bright and long lasting fragrance. This innovative formula dissolves completely in machine on its own without leaving any residue in machine or on clothes. It is formulated to give dazzling brightness to white and coloured clothes. Rin Liquid enables prevention from dullness of clothes so that your clothes stay, Bright like new up to 100 washesThis formulation is suitable for all types of clothes be it white or coloured. It involves a mess free wash as No Bar or Powder is needed additionally to clean the clothes. Rin Matic Liquid has the combination of long-lasting fragrance with ultimate clean ensures a superior laundry experience. It also has a beautiful balance of freshness and cleaning laundry cues, with modern and trendy notes, that deliver a delightful laundry experience, with a sense of care. Store the bottle in a cool place and wash hands immediately after use.\"], \"discountApplicable\":true, \"id\":\"4ad95205-6122-41b2-b5af-f18f187f924b\", \"ingredients\":\"\", \"l3CategoryDetails\":{\"id\":\"d0640dbf-8799-4305-af06-47f77701ebca\", \"name\":\"Top Load Liquid Detergent\"}, \"l3CategoryIds\":[\"d0640dbf-8799-4305-af06-47f77701ebca\"], \"manufacturerAddress\":\"\", \"manufacturerName\":\"HUL\", \"minimumRequiredAge\":0, \"name\":\"Rin Matic Top Load Detergent Liquid | Pouch\", \"rawTitle\":\"\"}, \"productCardTags\":{}, \"productVariant\":{\"formattedPac